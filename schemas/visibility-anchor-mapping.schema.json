{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "proof"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pair",
        "self",
        "to",
        "card",
        "lineage",
        "revision",
        "issuedAt"
      ],
      "properties": {
        "type": {
          "const": "anchor-mapping@3"
        },
        "pair": {
          "type": "string",
          "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
        },
        "self": {
          "type": "string",
          "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
        },
        "to": {
          "type": "string",
          "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
        },
        "card": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "body",
            "proof"
          ],
          "properties": {
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "anchor",
                "keyAgreement"
              ],
              "properties": {
                "type": {
                  "const": "self-card@1"
                },
                "anchor": {
                  "type": "string",
                  "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
                },
                "keyAgreement": {
                  "type": "string",
                  "pattern": "^z6LS[1-9A-HJ-NP-Za-km-z]{44}$"
                }
              }
            },
            "proof": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proofValue"
              ],
              "properties": {
                "proofValue": {
                  "type": "string",
                  "pattern": "^z[1-9A-HJ-NP-Za-km-z]{64,88}$"
                }
              }
            }
          }
        },
        "lineage": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body",
              "proof"
            ],
            "properties": {
              "body": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "prev",
                  "next"
                ],
                "properties": {
                  "type": {
                    "const": "anchor-rotation@1"
                  },
                  "prev": {
                    "type": "string",
                    "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$",
                    "description": "the community anchor the rotation leaves (Identity 5.4)"
                  },
                  "next": {
                    "type": "string",
                    "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$",
                    "description": "the community anchor the rotation moves to: the next generation of the same digest, or generation 1 of a new personal community (Identity 5.4, 9.3); it differs from prev"
                  }
                }
              },
              "proof": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "proofValue",
                  "successorProofValue"
                ],
                "properties": {
                  "proofValue": {
                    "type": "string",
                    "pattern": "^z[1-9A-HJ-NP-Za-km-z]{64,88}$",
                    "description": "raw Ed25519 under prev over the canonical (JCS) bytes of body, z-base58btc"
                  },
                  "successorProofValue": {
                    "type": "string",
                    "pattern": "^z[1-9A-HJ-NP-Za-km-z]{64,88}$",
                    "description": "raw Ed25519 under next over the same bytes"
                  }
                }
              }
            }
          },
          "description": "at most the 64 most recent anchor-rotation@1 artifacts of the lineage, in chain order: each prev equals the preceding next, the last next equals self (Network Visibility 6.1, 6.3, 6.5); empty where the sender presents no history",
          "maxItems": 64
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|[12][0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac1",
        "mac2"
      ],
      "properties": {
        "mac1": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "mac2": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      }
    }
  },
  "title": "RLTP anchor-mapping@3 (rltp-visibility@0.30)"
}
