{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-life.org/rltp/v1/schemas/trust-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "proof"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "revision",
        "name"
      ],
      "properties": {
        "type": {
          "const": "profile@1"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "image": {
          "type": "string",
          "pattern": "^data:image/(jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$",
          "maxLength": 60000
        },
        "text": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac"
      ],
      "properties": {
        "mac": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      }
    }
  },
  "title": "RLTP profile@1 (rltp-trust@0.31)",
  "description": "The sender's own name, an optional image and an optional text, sent within one relationship and proved by a mac under the directional profile key k_pr (Trust Layer 6b). Unsigned, about the sender only, one unchunked Delivery document."
}
