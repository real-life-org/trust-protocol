{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "proof"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "act",
        "issuedAt",
        "target",
        "cardDigest",
        "profile"
      ],
      "properties": {
        "type": {
          "const": "introduction-request@1"
        },
        "act": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|[12][0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
        },
        "target": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]+$",
          "maxLength": 343
        },
        "cardDigest": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]{45}[AQgw]$",
          "description": "sha2-256 multihash (0x12 0x20 + 32 hash bytes) over JCS of the complete card document including its proof, u-base64url (2.1)"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "type": "string",
              "maxLength": 64
            },
            "note": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofValue"
      ],
      "properties": {
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]{64,88}$"
        }
      }
    }
  },
  "title": "RLTP introduction-request@1 (rltp-visibility@0.30)"
}
