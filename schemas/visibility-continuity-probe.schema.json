{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "proof"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "probe",
        "seq",
        "last",
        "blinded"
      ],
      "properties": {
        "type": {
          "const": "continuity-probe@1"
        },
        "probe": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "seq": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "last": {
          "type": "boolean"
        },
        "blinded": {
          "type": "array",
          "minItems": 256,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^u[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac"
      ],
      "properties": {
        "mac": {
          "type": "string",
          "pattern": "^u[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        }
      }
    }
  },
  "title": "RLTP continuity-probe@1 (rltp-visibility@0.30)"
}
