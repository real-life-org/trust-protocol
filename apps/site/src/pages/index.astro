---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import Landing from '../components/Landing.astro'
import { encounterHtml } from '../lib/encounter'
import info from '../../public/build-info.json'

// The hero's eyebrow sits in the tagline; site.css lifts it above the title.
const chip = `<span class="tp-chip"><span class="tag">Editor's drafts</span><code>@real-life/trust-protocol ${info.lib}</code></span>`
const tagline = `${chip}<p>Your graph belongs to you. It grows from real encounters: two people meet, and each issues the other a verifiable credential under a fresh DID. From there you invite into groups, shared places with their own rules, end-to-end encrypted on every member's device.</p>`
---
<StarlightPage frontmatter={{
  title: 'Real Life Trust Protocol',
  description: 'A trust protocol rooted in encounters between people: specifications, library, simulators.',
  template: 'splash',
  tableOfContents: false,
  hero: {
    title: 'Trust through <span class="tp-accent">real encounters</span>',
    tagline,
    image: { html: encounterHtml() },
    actions: [
      { text: 'Foundations', link: '/understand/foundations/', icon: 'open-book', variant: 'primary' },
      { text: 'Simulators', link: '#in-action', icon: 'down-caret', variant: 'secondary' },
    ],
  },
}}>
  <Landing />
</StarlightPage>
