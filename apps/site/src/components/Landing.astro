---
import Icon from './Icon.astro'
import type { IconName } from './icons'
import { layerDiagramHtml } from '../lib/layers'
import info from '../../public/build-info.json'

const REPO = 'https://github.com/real-life-org/trust-protocol'
const spec = (file: string) => `${REPO}/blob/main/spec/${file}`
const sim = (file: string) => `/simulator/${file}`

const ways: { title: string; text: string; href: string; icon: IconName; cta: string }[] = [
  { title: 'Foundations', text: 'What a protocol developer needs first: identifiers, credentials, trust, groups, the ports. Then a primer per layer, then the specifications.', href: '/understand/foundations/', icon: 'layers', cta: 'Start reading →' },
  { title: 'Simulators', text: 'Three simulators in your browser: the app on three devices, one encounter under the microscope, the graph of who can prove what.', href: '/get-started/try-it/', icon: 'rocket', cta: 'Open a simulator →' },
  { title: 'Library', text: 'The library on npm, test vectors to reproduce byte for byte, and a conformance runner.', href: '/get-started/implement/', icon: 'wrench', cta: 'npm install →' },
]

type Card = [IconName, string, string, string]
const identity: Card[] = [
  ['fingerprint', 'One root seed', 'A BIP-39 mnemonic. Everything else is derived from it.', spec('identity-layer.md')],
  ['waypoints', 'An anchor per context', 'A did:key for each relationship, each group, the public.', spec('identity-layer.md')],
  ['hard-drive', 'Recovery', 'The mnemonic restores every key. Which contexts exist is data, kept in the person\'s encrypted state.', spec('identity-layer.md')],
]
const encounter: Card[] = [
  ['wot', 'The ceremony', 'Show, scan, confirm. Connected or fully offline, switching freely.', spec('encounter-layer.md')],
  ['shield-check', 'Encounter credentials', 'Verifiable credentials under fresh identifiers, never revoked.', spec('encounter-layer.md')],
  ['message-square', 'Contact cards', 'Signed addressing material, handed to the parties, not published.', spec('encounter-layer.md')],
]
const access: Card[] = [
  ['users', 'Groups as places', 'An encrypted document on every member device, with a signed log.', spec('access-layer.md')],
  ['shield', 'Policy as data', 'A decision rule the group states itself. No admins.', spec('access-layer.md')],
  ['lock', 'Epochs', 'A removal carries its key transition atomically.', spec('access-layer.md')],
]
const services: Card[] = [
  ['plug', 'Delivery contract', 'Sealed envelopes, signed acknowledgements, a closed set of delivery states.', spec('delivery-contract.md')],
  ['database', 'Replication contract', 'Signed, causally linked entries; key-blind by construction.', spec('replication-contract.md')],
]
const dtg: { label: string; text: string; href: string; repo: string }[] = [
  { label: 'Credentials', text: 'Encounter credentials are typed as DTG relationship credentials, invitations as DTG invitation credentials. The move to the current DTG context follows its implementer\'s draft.', href: 'https://github.com/trustoverip/dtgwg-cred-spec', repo: 'dtgwg-cred-spec' },
  { label: 'Trust Tasks', text: 'Every document between devices is a Trust Task document of a private type.', href: 'https://github.com/trustoverip/dtgwg-trust-tasks-spec', repo: 'dtgwg-trust-tasks-spec' },
  { label: 'Transport', text: 'An adapter for the VTI mediator is specified and implemented; it is being updated to TSP revision 3.', href: spec('adapter-vti-mediator.md'), repo: 'adapter-vti-mediator.md' },
]
---
<div class="tp-landing not-content">
  <section class="tp-ways" id="get-started">
    <div class="tp-cards three">
      {ways.map((w, i) => (
        <a class="tp-card way" href={w.href}>
          <div class="tp-card-head"><Icon name={w.icon} /><code>0{i + 1}</code></div>
          <strong>{w.title}</strong>
          <span>{w.text}</span>
          <em class="tp-cta">{w.cta}</em>
        </a>
      ))}
    </div>
  </section>

  <section class="tp-section flip" id="layers">
    <div>
      <div class="tp-badge">Architecture</div>
      <h2>Three layers, two services</h2>
      <p>RLTP specifies identity, encounter and access. An application sits on top and uses them through one library.</p>
      <p>Identities and relationships belong to the person, not to an app. Several apps can build on the same graph: a map, a chat, a tool a community has not built yet.</p>
      <p>Delivery and replication are services behind ports. The specification names no transport and no CRDT, only what a substrate has to guarantee.</p>
    </div>
    <Fragment set:html={layerDiagramHtml()} />
  </section>

  <section class="tp-section" id="identity">
    <div>
      <div class="tp-badge">Identity</div>
      <h2>One seed, an anchor per context</h2>
      <p>A person is one mnemonic. Every identifier toward a relationship, a group or the public is derived from it as a <code>did:key</code>.</p>
      <p>Contexts never link unless their holder decides to link them.</p>
      <p><a class="tp-more" href="/understand/foundations/#identifiers" aria-label="More on identifiers, in Foundations">More →</a></p>
    </div>
    <div class="tp-list">
      {identity.map(([icon, name, desc, href]) => (
        <a class="tp-item" href={href}><Icon name={icon} /><div><strong>{name}</strong><span>{desc}</span></div></a>
      ))}
    </div>
  </section>

  <section class="tp-section flip band" id="encounter">
    <div>
      <div class="tp-badge">Encounter</div>
      <h2>Credentials from recognition</h2>
      <p>Two people scan each other, connected or fully offline, and each issues a verifiable credential to the other under a fresh identifier.</p>
      <p>An encounter establishes key control, freshness and deliberate recognition, and nothing more. The specification says so.</p>
      <p><a class="tp-more" href="/understand/encounter/" aria-label="More on encounters, the Encounter primer">More →</a></p>
    </div>
    <div class="tp-list">
      {encounter.map(([icon, name, desc, href]) => (
        <a class="tp-item" href={href}><Icon name={icon} /><div><strong>{name}</strong><span>{desc}</span></div></a>
      ))}
    </div>
  </section>

  <section class="tp-section" id="access">
    <div>
      <div class="tp-badge">Access</div>
      <h2>Groups are places, not certificates</h2>
      <p>A group is an encrypted document replicated on every member's device, with a signed log of who joined, who left and which rules apply. Membership is a fact in that state and a capability: holding the key.</p>
      <p>There are no admins. Privileged operations are gated by a decision rule the group states as data, and a removal is a new key epoch.</p>
      <p><a class="tp-more" href="/understand/foundations/#groups" aria-label="More on groups, in Foundations">More →</a></p>
    </div>
    <div class="tp-list">
      {access.map(([icon, name, desc, href]) => (
        <a class="tp-item" href={href}><Icon name={icon} /><div><strong>{name}</strong><span>{desc}</span></div></a>
      ))}
    </div>
  </section>

  <section class="tp-section flip band" id="services">
    <div>
      <div class="tp-badge">Services</div>
      <h2>Delivery and replication behind ports</h2>
      <p>Documents travel sealed end to end, with signed acknowledgements and a closed set of delivery states.</p>
      <p>Replication is a contract of sixteen promises over signed, causally linked entries. Substrates are judged against the contract, not chosen by it.</p>
    </div>
    <div class="tp-cards two">
      {services.map(([icon, name, desc, href]) => (
        <a class="tp-card port" href={href}><Icon name={icon} /><strong>{name}</strong><span>{desc}</span></a>
      ))}
      <a class="tp-card row span" href={spec('adapter-vti-mediator.md')}>
        <Icon name="server" />
        <div><strong>VTI mediator adapter</strong><span>Delivery over the Verifiable Trust Infrastructure.</span></div>
        <em class="tp-tag">one adapter</em>
      </a>
    </div>
  </section>

  <section class="tp-section wide" id="in-action">
    <div>
      <div class="tp-badge">In action</div>
      <h2>See it run</h2>
      <p>Three simulators in your browser. Real Ed25519, X25519 and AES-GCM, no installation, nothing leaves your tab.</p>
    </div>
    <div class="tp-cards three">
      <a class="tp-card shot" href={sim('network.html')}>
        <div class="tp-shot devices" aria-hidden="true">
          <span class="tp-phone"><i class="hd"></i><i></i><i></i><i class="short"></i></span>
          <span class="tp-phone tall"><i class="hd"></i><i></i><i class="ok"></i><i></i><i class="short"></i></span>
          <span class="tp-phone"><i class="hd"></i><i></i><i class="warn"></i><i class="short"></i></span>
        </div>
        <div class="tp-shot-copy">
          <strong>The app</strong>
          <span>The same app on three devices side by side: verify, introduce, trust, found and join groups. Every sealed envelope on the wire, with fault injection.</span>
          <em class="tp-cta">Open the app →</em>
        </div>
      </a>
      <a class="tp-card shot" href={sim('index.html')}>
        <div class="tp-shot ceremony" aria-hidden="true">
          <span class="tp-phone wide"><i class="qr"></i></span>
          <span class="tp-channel"><i></i><code>+340 ms</code><i></i></span>
          <span class="tp-phone wide"><Icon name="shield-check" tile={false} /></span>
        </div>
        <div class="tp-shot-copy">
          <strong>The ceremony</strong>
          <span>One encounter under the microscope: two devices, one delivery channel, every receive stage, clock skew.</span>
          <em class="tp-cta">Open the ceremony →</em>
        </div>
      </a>
      <a class="tp-card shot" href={sim('graph.html')}>
        <div class="tp-shot graph" aria-hidden="true">
          <i class="edge e1"></i><i class="edge e2"></i><i class="edge e3 ok"></i><i class="edge e4 warn"></i>
          <b class="node n1"></b><b class="node n2"></b><b class="node n3"></b><b class="node n4 ok"></b>
          <code>chapter 3 / 8</code>
        </div>
        <div class="tp-shot-copy">
          <strong>The graph</strong>
          <span>The same world from above: who can prove what about whom, told in eight chapters.</span>
          <em class="tp-cta">Open the graph →</em>
        </div>
      </a>
    </div>
  </section>

  <section class="tp-section wide band" id="dtg">
    <div class="tp-head-row">
      <div>
        <div class="tp-badge">Interoperability</div>
        <h2>Where it meets the DTG</h2>
        <p>RLTP builds on the work of the ToIP Decentralized Trust Graph Working Group: its credentials, its Trust Tasks, its transport.</p>
        <p>A shared language keeps trust built from person to person and the world of credentials from becoming two walled gardens. <a class="tp-more" href="/understand/why/">Why invitations, not checkpoints →</a></p>
      </div>
      <span class="tp-pill">Trust over IP · DTG WG</span>
    </div>
    <div class="tp-cards three">
      {dtg.map((d) => (
        <a class="tp-card ref" href={d.href}>
          <span class="tp-kicker">{d.label}</span>
          <span class="text">{d.text}</span>
          <code>{d.repo}</code>
        </a>
      ))}
    </div>
  </section>

  <section class="tp-section" id="status">
    <div>
      <div class="tp-badge">Status</div>
      <h2>Where it stands</h2>
      <p>Editor's drafts. Identity, Encounter, Access, Delivery, Membership, Replication, Network Visibility and Personhood Predicates converged through adversarial review.</p>
      <p>The library is on npm with provenance. The first application is being built.</p>
      <p>The previous generation, <a href="https://github.com/real-life-org/wot-spec">wot-spec</a>, runs in production.</p>
    </div>
    <div class="tp-stats">
      <div class="tp-stat"><strong>8</strong><span>specifications converged</span></div>
      <div class="tp-stat"><strong>{info.lib}</strong><span>library on npm, with provenance</span></div>
      <div class="tp-stat"><strong>3</strong><span>simulators, in your browser</span></div>
      <div class="tp-stat live"><strong>In production</strong><span>wot-spec, the previous generation</span></div>
    </div>
  </section>

  <section class="tp-outro">
    <div>
      <h2>Start where it suits you</h2>
      <p>Read the foundations, run the simulators, or install the library and reproduce the vectors.</p>
    </div>
    <div class="tp-actions">
      <a class="tp-btn primary" href="/understand/foundations/">Foundations →</a>
      <a class="tp-btn" href="/get-started/try-it/">Simulators</a>
      <a class="tp-btn" href="/get-started/implement/">Library</a>
    </div>
  </section>
</div>
