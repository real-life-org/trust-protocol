---
// Left half of the checkpoint/invitation figure: a stranger checks the papers.
---
<svg class="tp-fig-half" viewBox="0 40 420 228" role="img" aria-labelledby="fig-cp-title">
  <title id="fig-cp-title">Checkpoint: a person with a wallet presents a credential to a verifier who is a stranger; the verifier admits them and a check log grows with every passage.</title>
  <defs>
    <marker id="cp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="cp-fill" /></marker>
  </defs>

  <rect x="8" y="80" width="102" height="58" class="box" />
  <text x="59" y="105" class="label" text-anchor="middle">Person</text>
  <text x="59" y="126" class="note" text-anchor="middle">with wallet</text>
  <line x1="110" y1="109" x2="186" y2="109" class="cp-line" marker-end="url(#cp-arrow)" />
  <text x="148" y="98" class="note cp-fill" text-anchor="middle">presents</text>

  <rect x="190" y="72" width="146" height="74" class="box cp-box" />
  <text x="263" y="102" class="label" text-anchor="middle">Verifier</text>
  <text x="263" y="126" class="note" text-anchor="middle">stranger · policy</text>
  <line x1="336" y1="109" x2="410" y2="109" class="cp-line" marker-end="url(#cp-arrow)" />
  <text x="373" y="98" class="note cp-fill" text-anchor="middle">admits</text>

  <line x1="263" y1="146" x2="263" y2="172" class="cp-line" marker-end="url(#cp-arrow)" />
  <rect x="186" y="176" width="150" height="26" class="cp-log" />
  <rect x="190" y="182" width="150" height="26" class="cp-log" />
  <rect x="194" y="188" width="150" height="26" class="cp-log cp-box" />
  <text x="269" y="206" class="note cp-fill" text-anchor="middle">check log grows</text>

  <text x="210" y="258" class="chain cp-fill" text-anchor="middle">show → check → admit</text>
</svg>
