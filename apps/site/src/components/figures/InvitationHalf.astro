---
// Right half of the checkpoint/invitation figure: the host checks their own graph.
---
<svg class="tp-fig-half" viewBox="0 30 420 204" role="img" aria-labelledby="fig-inv-title">
  <title id="fig-inv-title">Invitation: a person consults their own graph of friends, groups, events and places, asks where they know someone from, and invites them into a shared place.</title>
  <defs>
    <marker id="inv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="inv-fill" /></marker>
  </defs>

  <text x="92" y="70" class="label" text-anchor="middle">your graph</text>
  <line x1="94" y1="132" x2="50" y2="106" class="trust" />
  <line x1="94" y1="132" x2="138" y2="106" class="trust" />
  <line x1="94" y1="132" x2="140" y2="156" class="trust" />
  <line x1="94" y1="132" x2="50" y2="158" class="trust" />
  <circle cx="94" cy="132" r="10" class="inv-fill" />
  <circle cx="50" cy="106" r="6" class="node" /><text x="50" y="94" class="tag" text-anchor="middle">friend</text>
  <circle cx="138" cy="106" r="6" class="node" /><text x="138" y="94" class="tag" text-anchor="middle">group</text>
  <circle cx="140" cy="156" r="6" class="node" /><text x="140" y="180" class="tag" text-anchor="middle">event</text>
  <circle cx="50" cy="158" r="6" class="node" /><text x="50" y="182" class="tag" text-anchor="middle">place</text>

  <line x1="184" y1="126" x2="236" y2="126" class="inv-line" marker-end="url(#inv-arrow)" />
  <text x="210" y="115" class="note inv-fill" text-anchor="middle">invites</text>

  <rect x="254" y="44" width="150" height="126" rx="6" class="box inv-box" />
  <text x="329" y="70" class="label" text-anchor="middle">shared place</text>
  <line x1="294" y1="122" x2="329" y2="144" class="trust" />
  <line x1="329" y1="144" x2="364" y2="118" class="trust" />
  <line x1="294" y1="122" x2="364" y2="118" class="trust" />
  <circle cx="294" cy="122" r="6.5" class="inv-fill" />
  <circle cx="329" cy="144" r="6.5" class="inv-fill" />
  <circle cx="364" cy="118" r="6.5" class="inv-fill" />

  <text x="208" y="224" class="chain inv-fill" text-anchor="middle">know → invite → share</text>
</svg>
