---
// Right half of the checkpoint/invitation figure: the host checks their own graph.
---
<svg class="tp-fig-half" viewBox="0 30 420 200" role="img" aria-labelledby="fig-inv-title">
  <title id="fig-inv-title">Invitation: a person consults their own graph of friends, groups, events and places, asks where they know someone from, and invites them into a shared place.</title>
  <defs>
    <marker id="inv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="inv-fill" /></marker>
  </defs>

  <rect x="4" y="40" width="176" height="146" rx="6" class="box" />
  <text x="92" y="64" class="label" text-anchor="middle">your graph</text>
  <line x1="94" y1="126" x2="50" y2="100" class="trust" />
  <line x1="94" y1="126" x2="138" y2="100" class="trust" />
  <line x1="94" y1="126" x2="140" y2="150" class="trust" />
  <line x1="94" y1="126" x2="50" y2="152" class="trust" />
  <circle cx="94" cy="126" r="10" class="inv-fill" />
  <circle cx="50" cy="100" r="6" class="node" /><text x="50" y="88" class="tag" text-anchor="middle">friend</text>
  <circle cx="138" cy="100" r="6" class="node" /><text x="138" y="88" class="tag" text-anchor="middle">group</text>
  <circle cx="140" cy="150" r="6" class="node" /><text x="140" y="174" class="tag" text-anchor="middle">event</text>
  <circle cx="50" cy="152" r="6" class="node" /><text x="50" y="176" class="tag" text-anchor="middle">place</text>

  <line x1="186" y1="113" x2="230" y2="113" class="inv-line" marker-end="url(#inv-arrow)" />
  <text x="208" y="102" class="note inv-fill" text-anchor="middle">invites</text>

  <rect x="236" y="40" width="176" height="146" rx="6" class="box inv-box" />
  <text x="324" y="64" class="label" text-anchor="middle">shared place</text>
  <line x1="284" y1="118" x2="324" y2="140" class="trust" />
  <line x1="324" y1="140" x2="364" y2="114" class="trust" />
  <line x1="284" y1="118" x2="364" y2="114" class="trust" />
  <circle cx="284" cy="118" r="6.5" class="inv-fill" />
  <circle cx="324" cy="140" r="6.5" class="inv-fill" />
  <circle cx="364" cy="114" r="6.5" class="inv-fill" />

  <text x="208" y="220" class="chain inv-fill" text-anchor="middle">know → invite → share</text>
</svg>
