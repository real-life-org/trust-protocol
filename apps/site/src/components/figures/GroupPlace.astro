---
/**
 * A group as a place, in the landing's own pieces: the authority log as a
 * card with the accent border, the same log on each member's device below,
 * one device outside, dashed, with ciphertext only. Three entries carry the
 * idea: a founding, a rule stated as data, the rule applied. Styles:
 * site.css, .tp-place.
 */
import Icon from '../Icon.astro'
import type { IconName } from '../icons'

const log: { icon: IconName; op: string; by: string }[] = [
  { icon: 'fingerprint', op: 'genesis', by: 'Anna founds' },
  { icon: 'shield', op: 'rule: two admit', by: 'Anna, Peter' },
  { icon: 'users', op: 'admit Sam', by: 'Peter, Frida' },
]
const members = ['Anna', 'Peter', 'Sam']
---
<figure class="tp-place" aria-label="A group. Its authority log: Anna founds it, the rule becomes that two members admit, Peter and Frida admit Sam. The same log is on the devices of Anna, Peter and Sam. A device outside the group holds ciphertext only.">
  <div class="tp-place-log">
    <div class="tp-place-log-head"><span>Authority log</span><strong>Garden group</strong></div>
    <ol>
      {log.map((e) => (
        <li><Icon name={e.icon} /><span class="op">{e.op}</span><span class="by">{e.by}</span></li>
      ))}
    </ol>
  </div>

  <div class="tp-place-link" aria-hidden="true"><i></i><span>same log on every device</span><i></i></div>

  <div class="tp-place-devices">
    {members.map((name) => (
      <div class="tp-place-device">
        <span class="tp-place-screen"><i class="hd"></i><i></i><i class="short"></i></span>
        <strong>{name}</strong>
        <span class="state ok">holds the key</span>
      </div>
    ))}
    <div class="tp-place-device out">
      <span class="tp-place-screen"><i></i><i></i><i class="short"></i></span>
      <strong>Outside</strong>
      <span class="state">ciphertext only</span>
    </div>
  </div>

  <figcaption>Group state is a deterministic reading of the log, on each device. Only members can read it.</figcaption>
</figure>
