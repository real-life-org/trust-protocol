---
/**
 * A group as a place: the authority log inside a circle, member devices
 * around it holding the same log, one device outside with ciphertext only.
 * Three entries carry the idea: a founding, a rule stated as data, the rule
 * applied. Names are illustration. Styles: site.css, .tp-group.
 */
import { icons, type IconName } from '../icons'

const log: { icon: IconName; op: string; by: string }[] = [
  { icon: 'fingerprint', op: 'genesis', by: 'by Anna' },
  { icon: 'shield', op: 'rule: two admit', by: 'by Anna, Peter' },
  { icon: 'users', op: 'admit Sam', by: 'by Anna, Peter' },
]
type Device = { x: number; y: number; name: string; state: string; out?: boolean }
const devices: Device[] = [
  { x: 60, y: 60, name: 'Anna', state: 'holds the key' },
  { x: 520, y: 60, name: 'Peter', state: 'holds the key' },
  { x: 60, y: 262, name: 'Outside', state: 'ciphertext only', out: true },
  { x: 520, y: 262, name: 'Sam', state: 'holds the key' },
]
// Dashed links from each device to the circle's edge (centre 320,220, r 150).
const links = [
  [120, 108, 189, 147],
  [520, 108, 451, 147],
  [120, 310, 186, 285],
  [520, 310, 454, 285],
]
---
<figure class="tp-group">
  <svg viewBox="0 40 640 372" role="img" aria-labelledby="fig-group-title">
    <title id="fig-group-title">A group. Its authority log: Anna founds it, the rule becomes that two members admit, Anna and Peter admit Sam. The same log is on the devices of Anna, Peter and Sam, who hold the key. A device outside the group holds ciphertext only.</title>

    {links.map(([x1, y1, x2, y2]) => <line {x1} {y1} {x2} {y2} class="link" />)}

    {devices.map((d) => (
      <g class={d.out ? 'dev out' : 'dev'}>
        <rect x={d.x} y={d.y} width="60" height="96" rx="10" class="device" />
        <rect x={d.x + 14} y={d.y + 32} width="30" height="5" rx="2.5" class="mini strong" />
        <rect x={d.x + 14} y={d.y + 43} width="32" height="5" rx="2.5" class="mini" />
        <rect x={d.x + 14} y={d.y + 54} width="22" height="5" rx="2.5" class="mini" />
        <text x={d.x + 30} y={d.y + 120} class="name" text-anchor="middle">{d.name}</text>
        <text x={d.x + 30} y={d.y + 137} class="state" text-anchor="middle">{d.state}</text>
      </g>
    ))}

    <circle cx="320" cy="220" r="150" class="place" />
    <text x="320" y="146" class="kicker" text-anchor="middle">AUTHORITY LOG</text>
    <line x1="254" y1="190" x2="254" y2="216" class="spine" />
    <line x1="254" y1="244" x2="254" y2="270" class="spine" />
    {log.map((e, i) => {
      const y = 162 + i * 54
      return (
        <g>
          <rect x="240" y={y} width="28" height="28" rx="7" class="tile" />
          <g transform={`translate(247 ${y + 7}) scale(0.58)`} class="glyph" set:html={icons[e.icon]} />
          <text x="280" y={y + 13} class="op">{e.op}</text>
          <text x="280" y={y + 28} class="by">{e.by}</text>
        </g>
      )
    })}
  </svg>
  <figcaption>Group state is a deterministic reading of the log, on each device. Only members can read it.</figcaption>
</figure>
