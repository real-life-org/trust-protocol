---
/**
 * A group as a place: the authority log inside a circle, member devices
 * around it holding the same log, one device outside with ciphertext only.
 * Three entries carry the idea: a founding, a rule stated as data, the rule
 * applied. Names are illustration. Styles: site.css, .tp-group.
 */
import { icons, type IconName } from '../icons'

const log: { icon: IconName; op: string; by: string }[] = [
  { icon: 'fingerprint', op: 'genesis', by: 'by Anna' },
  { icon: 'users', op: 'admit Peter, Frida, Sam', by: 'by Anna' },
  { icon: 'shield', op: 'rule: two admit', by: 'by Anna, Peter' },
  { icon: 'lock', op: 'remove Frida', by: 'by Peter, Sam · new epoch' },
]
type Device = { x: number; y: number; name: string; state: string; out?: boolean }
const devices: Device[] = [
  { x: 60, y: 60, name: 'Anna', state: 'holds the key' },
  { x: 520, y: 60, name: 'Peter', state: 'holds the key' },
  { x: 60, y: 262, name: 'Frida', state: 'removed · ciphertext only', out: true },
  { x: 520, y: 262, name: 'Sam', state: 'holds the key' },
]
// Dashed links from each device to the circle's edge (centre 320,220, r 160).
const links = [
  [120, 108, 180, 142],
  [520, 108, 460, 142],
  [120, 310, 174, 286],
  [520, 310, 466, 286],
]
---
<figure class="tp-group">
  <svg viewBox="40 40 560 372" role="img" aria-labelledby="fig-group-title">
    <title id="fig-group-title">A group. Its authority log: Anna founds it, Anna admits Peter, Frida and Sam, the rule becomes that two members admit, Peter and Sam remove Frida, which starts a new key epoch. The same log is on the devices of Anna, Peter and Sam, who hold the key. Frida's device is outside now and holds ciphertext only.</title>

    {links.map(([x1, y1, x2, y2]) => <line {x1} {y1} {x2} {y2} class="link" />)}

    {devices.map((d) => (
      <g class={d.out ? 'dev out' : 'dev'}>
        <rect x={d.x} y={d.y} width="60" height="96" rx="10" class="device" />
        <rect x={d.x + 14} y={d.y + 26} width="30" height="5" rx="2.5" class="mini strong" />
        <rect x={d.x + 14} y={d.y + 38} width="34" height="5" rx="2.5" class="mini" />
        <rect x={d.x + 14} y={d.y + 50} width="26" height="5" rx="2.5" class="mini" />
        <rect x={d.x + 14} y={d.y + 62} width="30" height="5" rx="2.5" class="mini" />
        <text x={d.x + 30} y={d.y + 120} class="name" text-anchor="middle">{d.name}</text>
        <text x={d.x + 30} y={d.y + 137} class="state" text-anchor="middle">{d.state}</text>
      </g>
    ))}

    <circle cx="320" cy="220" r="160" class="place" />
    <text x="320" y="92" class="kicker" text-anchor="middle">AUTHORITY</text>
    <text x="320" y="108" class="kicker" text-anchor="middle">LOG</text>
    <line x1="244" y1="162" x2="244" y2="184" class="spine" />
    <line x1="244" y1="212" x2="244" y2="234" class="spine" />
    <line x1="244" y1="262" x2="244" y2="284" class="spine" />
    {log.map((e, i) => {
      const y = 134 + i * 50
      return (
        <g>
          <rect x="230" y={y} width="28" height="28" rx="7" class="tile" />
          <g transform={`translate(237 ${y + 7}) scale(0.58)`} class="glyph" set:html={icons[e.icon]} />
          <text x="270" y={y + 13} class="op">{e.op}</text>
          <text x="270" y={y + 28} class="by">{e.by}</text>
        </g>
      )
    })}
  </svg>
</figure>
