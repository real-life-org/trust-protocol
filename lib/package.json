{
  "name": "@real-life/trust-protocol",
  "version": "0.3.2",
  "description": "The Real Life Trust Protocol (RLTP) \u2014 the executable form of the specification: encounters, introductions, trust disclosure, groups, continuity, and the delivery channel. Zero dependencies, WebCrypto only.",
  "license": "CC-BY-4.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/index.*",
    "dist/probe.*",
    "dist/probe/",
    "dist/visibility.*",
    "dist/ceremony.*",
    "dist/core.*",
    "dist/crypto.*",
    "dist/identity.*",
    "dist/encounter.*",
    "dist/delivery.*",
    "dist/carrier.*",
    "dist/carrier-identity.*",
    "dist/holder.*",
    "dist/wire.*",
    "dist/schemas.*",
    "dist/unicode15.*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./probe": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/vectors.test.mjs test/vectors2.test.mjs test/vectors3.test.mjs test/vectors4.test.mjs test/probe.test.mjs test/encounter.test.mjs test/carrier.test.mjs test/loopback.test.mjs test/adapter-mediator.test.mjs",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "trust",
    "decentralized-identity",
    "did",
    "verifiable-credentials",
    "web-of-trust",
    "rltp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/real-life-org/trust-protocol",
    "directory": "lib"
  },
  "homepage": "https://rltp.real-life.org",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  }
}
